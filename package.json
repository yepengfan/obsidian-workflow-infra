{
  "name": "obsidian-workflow-infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IaC adoption and management of existing private Obsidian S3 storage",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "synth": "cdk synth --no-lookups",
    "check:cognito": "tsx bin/check-cognito.ts",
    "diff": "cdk diff --method=template --no-lookups"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "aws-cdk-lib": "2.276.0",
    "constructs": "10.8.1",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@smithy/types": "4.20.0",
    "@types/node": "26.6.6",
    "aws-cdk": "2.1148.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
